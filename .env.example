# Caminho absoluto dos projetos no host (padrão: pasta projetos no seu HOME)
PROJETOS_PATH=${HOME}/projetos

# UID/GID do usuário no container (alinhado ao seu usuário Linux/macOS)
USER_UID=1000
USER_GID=1000

# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=dev
MYSQL_USER=dev
MYSQL_PASSWORD=dev
MYSQL_DATA_PATH=${HOME}/.docker/dev-php81-mysql

# Portas (evite conflito com outros stacks)
HTTP_PORT=80
MYSQL_PORT=3306
